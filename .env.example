# Copy to .env. Keep credentials and live channel IDs out of Git.
DISCORD_BOT_TOKEN=''

# Join-to-create voice rooms: set all three IDs to enable.
DISCORD_VOICE_GUILD_ID=''
DISCORD_VOICE_CATEGORY_ID=''
DISCORD_VOICE_LOBBY_CHANNEL_ID=''
DISCORD_VOICE_STATE_PATH='.rooms.json'

# Optional counters. A blank URL disables this feature.
SRP_ONLINE_URL=''
SRP_SOURCE_FORMAT='json'
SRP_POLL_SECONDS=60
SRP_ACCOUNT_TOKEN=''
DISCORD_ONLINE_CHANNEL_ID=''
DISCORD_REGISTERED_CHANNEL_ID=''

