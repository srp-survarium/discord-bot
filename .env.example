# Copy to .env. Keep credentials and live channel IDs out of Git.
DISCORD_BOT_TOKEN=''

# Join-to-create voice rooms: set all three IDs to enable.
DISCORD_VOICE_GUILD_ID=''
DISCORD_VOICE_CATEGORY_ID=''
DISCORD_VOICE_LOBBY_CHANNEL_ID=''
DISCORD_VOICE_STATE_PATH='.rooms.json'

# Optional moderation guard. Remove the selected role after the 11th distinct
# person kicked/banned in an hour, 16th in 24 hours, or 3rd in 30 seconds.
# Never auto-restore.
# Bot needs Manage Roles, View Audit Log, and a role above the guarded role.
DISCORD_GUARD_GUILD_ID=''
DISCORD_GUARD_ROLE_ID=''

# Optional counters. A blank URL disables this feature.
SRP_ONLINE_URL=''
SRP_SOURCE_FORMAT='json'
SRP_POLL_SECONDS=10
SRP_ACCOUNT_TOKEN=''
DISCORD_ONLINE_CHANNEL_ID=''
DISCORD_REGISTERED_CHANNEL_ID=''
DISCORD_MATCHES_CHANNEL_ID=''
DISCORD_QUEUED_CHANNEL_ID=''

# Skhid example:
# SRP_ONLINE_URL='https://026g.skhid.link/api/stats'
# SRP_SOURCE_FORMAT='json'
